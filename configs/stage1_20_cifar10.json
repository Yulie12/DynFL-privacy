{
  "dataset": "cifar10",
  "model": "resnet18_head",
  "data_root": "data",
  "device": "cuda",
  "protocol": "global_barrier_100",
  "cloud_quorum": 1.0,
  "experiment_version": "staged_eight_v1",
  "shared_init_rounds": 10,
  "snapshot_interval": 5,
  "train_limit": 50000,
  "test_limit": 10000,
  "clients": 100,
  "edges": 10,
  "rounds": 20,
  "seeds": [42],
  "policies": ["latency_only", "joint_no_ema", "proposed"],
  "local_steps": 2,
  "edge_stages": 3,
  "learning_rate": 0.01,
  "epsilon": 8.0,
  "delta": 1e-5,
  "gamma_d": 0.9,
  "gamma_c": 0.9,
  "selection_period": 1,
  "evaluation_budget": 8,
  "archive_size": 16,
  "output_root": "out/stage1_20_cifar10"
}
