{
  "dataset": "cifar10",
  "model": "resnet18_head",
  "data_root": "data",
  "device": "cuda",
  "protocol": "global_barrier_100",
  "cloud_quorum": 1.0,
  "snapshot_interval": 10,
  "train_limit": 50000,
  "test_limit": 10000,
  "clients": 100,
  "edges": 10,
  "rounds": 100,
  "seeds": [42, 43, 44],
  "policies": ["latency_only", "joint_no_ema", "proposed", "fixed_fl_e", "fixed_fl_ec", "fixed_fl_c", "fixed_mixed", "random_feasible"],
  "local_steps": 2,
  "edge_stages": 3,
  "learning_rate": 0.01,
  "epsilon": 8.0,
  "delta": 1e-5,
  "gamma_d": 0.9,
  "gamma_c": 0.9,
  "shared_init_rounds": 10,
  "experiment_version": "staged_eight_v1",
  "selection_period": 1,
  "evaluation_budget": 8,
  "archive_size": 16,
  "output_root": "out/paper_cifar10"
}
