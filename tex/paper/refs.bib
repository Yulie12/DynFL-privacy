@article{ZHU2024303,
title = {Load-aware task migration algorithm toward adaptive load balancing in Edge Computing},
journal = {Future Generation Computer Systems},
volume = {157},
pages = {303-312},
year = {2024},
issn = {0167-739X},
doi = {https://doi.org/10.1016/j.future.2024.03.014},
url = {https://www.sciencedirect.com/science/article/pii/S0167739X24000864},
author = {Xikang Zhu and Wenbin Yao and Wenhao Wang},
keywords = {Edge computing, Load balancing, Task selection, Task migration, Weighted tripartite graph},
abstract = {The rapid advancement of the Internet of Things (IoT) is leading to more and more devices joining the network to interact with information, which requires improving the performance of IoT applications to accommodate more data, faster response times, and more complex tasks. Edge computing, as a new computing paradigm, brings resource contention and load imbalance while reducing communication overhead and task latency. This paper addresses the workload distribution challenge in edge networks, aiming to optimize resource utilization and thereby enhance IoT application performance. To achieve this goal, we present the Load-aware Task Migration (LATM) algorithm. Firstly, we present a load state detection model that captures edge nodes' workloads and dynamically classifies them according to their resource requirements. We then propose an innovative optimization problem, transforming task migration into a weighted tripartite graph matching problem. This problem leverages the Kuhn-Munkres(KM) task migration algorithm to attain the optimal matching between tasks and nodes. Finally, we assess the algorithm's performance through experimental simulation. The experimental results underscore the algorithm's substantial potential in reducing task response times, task execution times, load balance, and enhancing resource utilization.}
}

@article{ZHANG2019111,
title = {Task migration for mobile edge computing using deep reinforcement learning},
journal = {Future Generation Computer Systems},
volume = {96},
pages = {111-118},
year = {2019},
issn = {0167-739X},
doi = {https://doi.org/10.1016/j.future.2019.01.059},
url = {https://www.sciencedirect.com/science/article/pii/S0167739X18329674},
author = {Cheng Zhang and Zixuan Zheng},
keywords = {Service migration, Mobile edge computing, Deep reinforcement learning},
abstract = {Mobile edge computing (MEC) is a new network architecture that puts computing capabilities and storage resource at the edges of the network in a distributed manner, instead of a kind of centralized cloud computing architecture. The computation tasks of the users can be offloaded to the nearby MEC servers to achieve high quality of computation experience. As many applications' users have high mobility, such as applications of autonomous driving, the original MEC server with the offloaded tasks may become far from the users. Therefore, the key challenge of the MEC is to make decisions on where and when the tasks had better be migrated according to users' mobility. Existing works formulated this problem as a sequential decision making model and using Markov decision process (MDP) to solve, with assumption that mobility pattern of the users is known ahead. However, it is difficult to get users' mobility pattern in advance. In this paper, we propose a deep Q-network (DQN) based technique for task migration in MEC system. It can learn the optimal task migration policy from previous experiences without necessarily acquiring the information about users' mobility pattern in advance. Our proposed task migration algorithm is validated by conducting extensive simulations in the MEC system.}
}

@article{CHEN2026112204,
title = {Hermes: Multi-job federated learning with switching cost in wireless networks},
journal = {Computer Networks},
volume = {281},
pages = {112204},
year = {2026},
issn = {1389-1286},
doi = {https://doi.org/10.1016/j.comnet.2026.112204},
url = {https://www.sciencedirect.com/science/article/pii/S1389128626002161},
author = {Junmei Chen and Hanxu Hou and Yeqiao Hou and Zongpeng Li},
keywords = {Multi-job federated learning, Client selection, Multi-armed bandit, Virtual queue, Optimization, Switching cost},
abstract = {Federated Learning (FL) enables collaborative model training across multiple clients without the need of sharing raw data, thereby addressing critical privacy concerns. This work explores a multi-job FL setup where multiple FL jobs are trained concurrently with a shared pool of clients, creating a complex challenge due to the heterogeneity of jobs and clients, include balancing training latency, model accuracy, client quality variability, and potential switching costs in client selection. We introduce Hermes, a framework tailored to enhance training efficiency in dynamic multi-job FL environments. Hermes integrates three main innovations: (1) Block-based client subset switching, which reduces switching costs by selecting clients over extended intervals instead of per round; (2) By integrating the multi-armed bandit (MAB) algorithms and virtual queue techniques, we develop an adaptive client selection policy that balances latency, accuracy, and budget levels, in which MAB is employed to measure stochastic client latency and model accuracy, while virtual queues are responsible for monitoring budget usage; and (3) Greedy Job Assignment, a mechanism to resolve conflicts when multiple jobs compete for the same client. Our PyTorch-based implementation of Hermes demonstrates up to a 53.4% reduction in the weighted sum of latency, training loss, and switching costs over existing FL frameworks, with provably sublinear regret in client selection and block-wise switching.}
}

