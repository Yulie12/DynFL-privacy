+def _cloud_update_coverage_ratio(
+    profile: dict[int, Candidate],
+    client_samples: dict[int, float],
+    admitted_client_ids: tuple[int, ...] | list[int],
+) -> float:
+    """Fraction of represented samples reaching the Cloud via protected updates."""
+    admitted = set(admitted_client_ids)
+    total = sum(max(float(v), 0.0) for v in client_samples.values())
+    if total <= 0.0:
+        return 0.0
+    cloud = 0.0
+    for client_id, candidate in profile.items():
+        if client_id in admitted and any(
+            link_id.endswith("_C_upd") and mechanism_uses_dp(mech)
+            for link_id, mech in candidate_link_mechanisms(candidate).items()
+        ):
+            cloud += max(float(client_samples.get(client_id, 0.0)), 0.0)
+    return cloud / total
+
+
+def _global_dp_perturbation_cost(
+    config: SelectionConfig,
+    profile: dict[int, Candidate],
+    client_samples: dict[int, float],
+    client_edges: dict[int, int],
+    admitted_client_ids: tuple[int, ...] | list[int] | None = None,
+) -> float:
+    """Compute the paper's Cloud-facing DP perturbation objective.
+
+    Direct client updates use normalized Cloud weights. Edge-aggregated updates
+    use the group sample mass, the maximum within-group client weight for
+    sensitivity, and the maximum calibrated client noise multiplier.
+    """
+    admitted = set(profile) if admitted_client_ids is None else set(admitted_client_ids)
+    dim = max(float(config.omega_update_dimension), 0.0)
+    clip = max(float(config.omega_update_clip_norm), 0.0)
+    if dim <= 0.0 or clip <= 0.0:
+        return 0.0
+
+    direct_mass: dict[int, float] = {}
+    edge_groups: dict[int, list[tuple[int, Candidate, float]]] = {}
+    cloud_mass = 0.0
+
+    for client_id, candidate in profile.items():
+        if client_id not in admitted:
+            continue
+        mechanisms = candidate_link_mechanisms(candidate)
+        if mechanism_uses_dp(mechanisms.get("L_C_upd", "none")):
+            mass = max(float(client_samples.get(client_id, 0.0)), 0.0)
+            direct_mass[client_id] = mass
+            cloud_mass += mass
+        if mechanism_uses_dp(mechanisms.get("E_C_upd", "none")):
+            mass = max(float(client_samples.get(client_id, 0.0)), 0.0)
+            edge_id = int(client_edges.get(client_id, -1))
+            edge_groups.setdefault(edge_id, []).append((client_id, candidate, mass))
+            cloud_mass += mass
+
+    if cloud_mass <= 0.0:
+        return 0.0
+
+    cost = 0.0
+    sensitivity = 2.0 * clip
+    for client_id, mass in direct_mass.items():
+        weight = mass / cloud_mass
+        sigma = max(float(profile[client_id].update_noise_multiplier or 0.0), 0.0)
+        cost += (weight * sigma * sensitivity) ** 2
+
+    for members in edge_groups.values():
+        group_mass = sum(item[2] for item in members)
+        if group_mass <= 0.0:
+            continue
+        group_weight = group_mass / cloud_mass
+        max_client_weight = max(item[2] / group_mass for item in members)
+        sigma_group = max(
+            (float(item[1].update_noise_multiplier or 0.0) for item in members),
+            default=0.0,
+        )
+        delta_group = sensitivity * max_client_weight
+        cost += (group_weight * sigma_group * delta_group) ** 2
+
+    return dim * cost
+
