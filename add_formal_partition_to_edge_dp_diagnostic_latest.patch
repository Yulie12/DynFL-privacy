+) -> tuple[list[np.ndarray], list[np.ndarray], list[np.ndarray]]:
+    """Reuse the formal runner partition and per-client holdout semantics."""
+    if not 0.0 <= holdout_ratio < 1.0:
+        raise ValueError("holdout_ratio must satisfy 0 <= holdout_ratio < 1")
+    full = _partition_clients_lenet5(
+        labels, num_clients, num_edges, partition_mode == "iid", partition_mode, seed
+    )
+    train, holdout = _split_client_indices(full, test_ratio=holdout_ratio, seed=seed)
+    if any(len(idx) == 0 for idx in train):
+        raise ValueError("Partition/holdout produced an empty client training cohort")
+    return full, train, holdout
