+++ b/tests/test_diagnostic_partition_alignment.py
@@ -0,0 +1,61 @@
+import numpy as np
+import pytest
+
+from experiments.validate_edge_dp_trajectory import build_diagnostic_client_splits
+from dynfed.fmnist_lenet5_dynamic import _partition_clients_lenet5, _split_client_indices
+
+
+def _labels(samples_per_class=100):
+    return np.repeat(np.arange(10, dtype=np.int64), samples_per_class)
+
+
+@pytest.mark.parametrize("partition_mode", ["iid", "extreme_edge_label_skew"])
+def test_diagnostic_partition_matches_formal_runner(partition_mode):
+    labels = _labels()
+    full, train, holdout = build_diagnostic_client_splits(
+        labels,
+        num_clients=100,
+        num_edges=10,
+        partition_mode=partition_mode,
+        holdout_ratio=0.2,
+        seed=42,
+    )
+
+    expected_full = _partition_clients_lenet5(
+        labels,
+        100,
+        10,
+        partition_mode == "iid",
+        partition_mode,
+        42,
+    )
+    expected_train, expected_holdout = _split_client_indices(expected_full, test_ratio=0.2, seed=42)
+
+    assert len(full) == len(train) == len(holdout) == 100
+    for actual, expected in zip(full, expected_full):
+        np.testing.assert_array_equal(actual, expected)
+    for actual, expected in zip(train, expected_train):
+        np.testing.assert_array_equal(actual, expected)
+    for actual, expected in zip(holdout, expected_holdout):
+        np.testing.assert_array_equal(actual, expected)
+
+
+def test_diagnostic_holdout_is_disjoint_and_reproducible():
+    labels = _labels()
+    first = build_diagnostic_client_splits(labels, 100, 10, "extreme_edge_label_skew", 0.2, 42)
+    second = build_diagnostic_client_splits(labels, 100, 10, "extreme_edge_label_skew", 0.2, 42)
+
+    for first_group, second_group in zip(first, second):
+        for a, b in zip(first_group, second_group):
+            np.testing.assert_array_equal(a, b)
+
+    full, train, holdout = first
+    for complete, local_train, local_holdout in zip(full, train, holdout):
+        assert set(local_train.tolist()).isdisjoint(local_holdout.tolist())
+        assert set(local_train.tolist()) | set(local_holdout.tolist()) == set(complete.tolist())
+
+
+def test_diagnostic_rejects_invalid_holdout_ratio():
+    labels = _labels()
+    with pytest.raises(ValueError, match="holdout_ratio"):
+        build_diagnostic_client_splits(labels, 100, 10, "iid", 1.0, 42)
