+def latest_preferred_completed_status_payload() -> dict | None:
+    """Prefer the newest formal run; fall back to the newest diagnostic run."""
+    experiments = available_experiments()
+    for category in ("formal", "diagnostic"):
+        for item in experiments:
+            if item.get("category") != category:
+                continue
+            payload = _status_payload_from_run(
+                Path(str(item["path"])),
+                fallback_message=f"Loaded latest {category} experiment: {item['name']}",
+            )
+            if payload is not None:
+                payload["preferred_experiment_fallback"] = True
+                return payload
+    return None
