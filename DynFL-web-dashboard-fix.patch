+function renderExperimentSelector(items, currentRunDir) {
+  const select = $("experimentSelect");
+  if (!select) return;
+  const previous = select.value;
+  const options = [`<option value="">Automatic (latest formal)</option>`].concat((items || []).map(item => {
+    const label = `${item.category === "formal" ? "FORMAL" : "DIAG"} · ${item.name}${item.dataset ? " · " + item.dataset : ""}${item.partition ? " · " + item.partition : ""}`;
+    return `<option value="${item.id}">${label}</option>`;
+  }));
+  select.innerHTML = options.join("");
+  const match = (items || []).find(item => item.path === currentRunDir);
+  if (match) select.value = match.id;
+  else if ([...select.options].some(o => o.value === previous)) select.value = previous;
+}
+
+function renderDiagnostics(items, category) {
+  const target = $("diagnosticGrid");
+  if (!target) return;
+  const activePol = latestStatus.active_policy || latestStatus.policy;
+  const item = (items || []).find(p => p.policy === activePol) || (items || [])[0];
+  const d = item?.diagnostics || {};
+  const fields = [
+    ["Clip fraction", "update_dp_clip_fraction", 3],
+    ["Signal norm", "pre_dp_global_update_norm", 6],
+    ["DP noise norm", "update_dp_noise_norm", 6],
+    ["Noise / signal", "update_dp_noise_to_signal_ratio", 3],
+    ["Mean direction cosine", "direction_mean_client_cosine", 4],
+    ["Negative cosine fraction", "direction_negative_cosine_fraction", 3],
+    ["Aggregate / mean-client norm", "direction_aggregate_to_mean_client_norm_ratio", 4],
+    ["Raw aggregate norm", "direction_raw_aggregate_norm", 6],
+    ["Mean client norm", "direction_mean_client_norm", 6]
+  ];
+  const available = fields.filter(([, key]) => d[key] != null && d[key] !== "");
+  if (!available.length) {
+    target.innerHTML = `<div class="sub">No diagnostic fields in this run's round_metrics.csv.</div>`;
+    return;
+  }
+  target.innerHTML = available.map(([label, key, digits]) =>
+    `<div class="diagnostic-card"><div class="label">${label}</div><div class="metric">${fmt(d[key], digits)}</div></div>`
+  ).join("");
+}
