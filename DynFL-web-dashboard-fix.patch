+def _experiment_category(run_dir: Path) -> str:
+    """Classify a run for the dashboard without treating folder names as the primary truth."""
+    config = _read_run_config(run_dir)
+    selection = config.get("selection", {}) if isinstance(config, dict) else {}
+    training = config.get("training", {}) if isinstance(config, dict) else {}
+    name = str(run_dir).lower()
+
+    # Diagnostic runs deliberately bypass or alter the formal DP release contract.
+    dp_mode = str(training.get("dp_update_mode", "")).lower()
+    if dp_mode == "off" or "diag" in name or "diagnostic" in name or "cliponly" in name or "clip_only" in name:
+        return "diagnostic"
+
+    # A formal v30-style run must use the fused global-release contract.  This
+    # positive check prevents old/legacy output directories from silently
+    # entering paper-facing tables just because their folder name looks new.
+    if (
+        bool(selection.get("mainline_fusion"))
+        and str(selection.get("dp_accounting_mode", "")).lower() == "rdp_auto"
+        and dp_mode not in {"", "off"}
+        and str(training.get("he_execution", "")).lower() == "real"
+        and bool(training.get("require_real_he"))
+    ):
+        return "formal"
+    return "legacy"
+
+
+def available_experiments(limit: int = 120) -> list[dict]:
+    """Return formal/diagnostic runs for the experiment selector; legacy runs stay hidden."""
+    out_root = ROOT / "out"
+    if not out_root.exists():
+        return []
+    items: list[dict] = []
+    seen: set[Path] = set()
+    for config_path in _safe_rglob(out_root, "config.json"):
+        run_dir = config_path.parent
+        if run_dir in seen or "paper_experiments" in run_dir.parts or "merged_runs" in run_dir.parts:
+            continue
+        seen.add(run_dir)
+        category = _experiment_category(run_dir)
+        if category == "legacy":
+            continue
+        config = _read_run_config(run_dir)
+        selection = config.get("selection", {}) if config else {}
+        training = config.get("training", {}) if config else {}
+        items.append({
+            "id": str(run_dir.relative_to(out_root)).replace("\\", "/"),
+            "name": run_dir.name,
+            "path": str(run_dir),
+            "category": category,
+            "mtime": config_path.stat().st_mtime,
+            "dataset": training.get("dataset_name"),
+            "model": training.get("model_name"),
+            "partition": training.get("partition_mode"),
+            "dp_update_mode": training.get("dp_update_mode"),
+            "he_execution": training.get("he_execution"),
+            "rounds": selection.get("rounds"),
+        })
+    items.sort(key=lambda item: (0 if item["category"] == "formal" else 1, -float(item["mtime"])))
+    return items[:limit]
+
