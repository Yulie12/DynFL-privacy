+def _status_payload_from_run(run_dir: Path, *, fallback_message: str | None = None) -> dict | None:
+    status_path = run_dir / "live_status.json"
+    payload: dict = {}
+    if status_path.exists():
+        try:
+            with status_path.open("r", encoding="utf-8-sig") as file:
+                payload = json.load(file)
+        except (json.JSONDecodeError, OSError):
+            payload = {}
+    config = _read_run_config(run_dir)
+    policies = list(config.get("policies", [])) if config else []
+    if not payload and policies:
+        for policy in policies:
+            summary_path = run_dir / str(policy) / "summary.json"
+            if not summary_path.exists():
+                continue
+            try:
+                with summary_path.open("r", encoding="utf-8-sig") as file:
+                    summary = json.load(file)
+            except (json.JSONDecodeError, OSError):
+                continue
+            payload = {
+                "status": summary.get("status", "completed"),
+                "active_policy": str(policy),
+                "policy": str(policy),
+                "round": summary.get("rounds", 0),
+                "rounds": summary.get("rounds", 0),
+                "progress": 1.0,
+                "test_accuracy": summary.get("final_test_accuracy"),
+                "best_test_accuracy": summary.get("best_test_accuracy"),
+                "logical_time": summary.get("total_logical_time"),
+                "cumulative_communication_volume": summary.get("total_communication_volume"),
+            }
+            break
+    if not payload:
+        return None
+    payload["status_path"] = str(status_path if status_path.exists() else run_dir)
+    payload["run_dir"] = str(run_dir)
+    payload["output_root"] = str(run_dir.parent)
+    payload["experiment_category"] = _experiment_category(run_dir)
+    payload["message"] = fallback_message or payload.get("message") or f"Loaded {payload['experiment_category']} run: {run_dir.name}"
+    payload["policy_statuses"] = read_policy_statuses(run_dir, payload)
+    payload["run_figures"] = available_run_figures(run_dir)
+    payload["paper_experiments"] = available_paper_experiments()
+    payload["merged_runs"] = available_merged_runs()
+    payload["merge_sources"] = available_merge_sources()
+    payload["delete_targets"] = available_delete_targets()
+    payload["experiments"] = available_experiments()
+    return payload
+
