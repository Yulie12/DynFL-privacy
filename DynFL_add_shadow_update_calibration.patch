+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from dynfed.fmnist_lenet5_dynamic import (  # noqa: E402
+    _partition_clients_lenet5,
+    _split_client_indices,
+    load_image_dataset_arrays,
+)
+from dynfed.selection import SelectionConfig, resolved_privacy_parameters  # noqa: E402
+from dynfed.split_learning import (  # noqa: E402
+    build_split_pair,
+    normalize_model_name,
+    split_local_train_lenet5,
+)
+
+
+def parse_args() -> argparse.Namespace:
+    p = argparse.ArgumentParser(
+        description=(
+            "Calibrate feature-DP utility by comparing clean, clip-only, and "
+            "clip+DP split-training updates under identical data and seeds."
+        )
+    )
+    p.add_argument("--dataset", default="cifar10", choices=["fmnist", "cifar10", "cifar100"])
+    p.add_argument("--model", default="resnet18_pretrained_head")
+    p.add_argument("--data-root", default=None)
+    p.add_argument("--train-limit", type=int, default=12000)
+    p.add_argument("--test-limit", type=int, default=2000)
+    p.add_argument("--partition-mode", default="iid", choices=["iid", "dirichlet", "client_noniid", "edge_label_skew", "extreme_edge_label_skew"])
+    p.add_argument("--dirichlet-alpha", type=float, default=0.5)
+    p.add_argument("--clients", type=int, default=100)
+    p.add_argument("--edges", type=int, default=10)
+    p.add_argument("--client-ids", nargs="+", type=int, default=[0, 1, 2, 3, 4])
+    p.add_argument("--mode", default="LIC", choices=["LIE", "LIC", "LIEIIC", "LIEIIIC"])
+    p.add_argument("--local-epochs", type=int, default=3)
+    p.add_argument("--lr", type=float, default=0.01)
+    p.add_argument("--seed", type=int, default=42)
+    p.add_argument("--device", default="cuda")
+    p.add_argument("--rounds", type=int, default=1, help="RDP calibration horizon used by the compared formal run.")
+    p.add_argument("--initial-epsilon", type=float, default=8.0)
+    p.add_argument("--feature-epsilon-budget", type=float, default=None)
+    p.add_argument("--dp-delta", type=float, default=1e-5)
+    p.add_argument("--feature-clip-norm", type=float, default=0.25)
+    p.add_argument("--feature-noise-multiplier", type=float, default=None)
+    p.add_argument("--feature-jacobian-norm", type=float, default=1.0)
+    p.add_argument("--feature-lipschitz", type=float, default=1.0)
+    p.add_argument("--output", default="out/feature_shadow_update.csv")
+    return p.parse_args()
+
+
+def _nested_vector(update: dict[str, dict[str, torch.Tensor]]) -> torch.Tensor:
+    pieces: list[torch.Tensor] = []
+    for part in ("end", "edge"):
+        for name in sorted(update.get(part, {})):
+            value = update[part][name]
+            if torch.is_floating_point(value) or torch.is_complex(value):
+                pieces.append(value.detach().float().cpu().reshape(-1))
+    if not pieces:
+        return torch.zeros(0, dtype=torch.float32)
+    return torch.cat(pieces)
+
+
+def _sq_distance(a: torch.Tensor, b: torch.Tensor) -> float:
+    if a.shape != b.shape:
+        raise ValueError(f"update shapes differ: {tuple(a.shape)} vs {tuple(b.shape)}")
+    return float(torch.dot(a - b, a - b).item())
+
+
+def _norm(a: torch.Tensor) -> float:
+    return float(torch.linalg.vector_norm(a).item())
+
+
+def _cosine(a: torch.Tensor, b: torch.Tensor) -> float:
+    na, nb = _norm(a), _norm(b)
+    if na <= 1e-12 or nb <= 1e-12:
+        return 0.0
+    return float(torch.dot(a, b).item() / (na * nb))
+
+
+def _train_once(
+    *,
+    mode: str,
+    end_state: dict[str, torch.Tensor],
+    edge_state: dict[str, torch.Tensor],
+    x: np.ndarray,
+    y: np.ndarray,
+    epochs: int,
+    lr: float,
+    device: torch.device,
+    model_name: str,
+    input_shape: tuple[int, int, int],
+    num_classes: int,
+    clip_norm: float,
+    noise_multiplier: float,
+    use_feature_dp: bool,
+    seed: int,
+) -> tuple[torch.Tensor, dict[str, float]]:
+    diagnostics: dict[str, float] = {}
+    update = split_local_train_lenet5(
+        mode=mode,
+        global_end_state=end_state,
+        global_edge_state=edge_state,
+        x=x,
+        y=y,
+        epochs=epochs,
+        lr=lr,
+        device=device,
+        model_name=model_name,
+        input_shape=input_shape,
+        num_classes=num_classes,
+        mechanisms={"emb": "dp" if use_feature_dp else "none", "grad": "none", "upd": "none"},
+        dp_clip_norm=clip_norm,
+        dp_noise_multiplier=noise_multiplier,
+        dp_rng=np.random.default_rng(seed + 100_003),
+        dp_epsilon=1.0,
+        training_seed=seed,
+        model_cache=None,
+        training_diagnostics=diagnostics,
+    )
+    return _nested_vector(update), diagnostics
+
+
+def main() -> None:
+    args = parse_args()
+    device = torch.device(args.device)
+    if device.type == "cuda" and not torch.cuda.is_available():
+        raise RuntimeError("CUDA requested but torch.cuda.is_available() is false")
+
+    x_train, y_train, _x_test, _y_test, input_shape, _label, num_classes = load_image_dataset_arrays(
+        args.dataset,
+        Path(args.data_root) if args.data_root else Path("data"),
+        args.train_limit,
+        args.test_limit,
+        args.seed,
+    )
+    client_indices = _partition_clients_lenet5(
+        y_train=y_train,
+        num_clients=args.clients,
+        num_edges=args.edges,
+        iid=args.partition_mode == "iid",
+        partition_mode=args.partition_mode,
+        seed=args.seed,
+        dirichlet_alpha=args.dirichlet_alpha,
+    )
+    client_train_indices, _ = _split_client_indices(client_indices, test_ratio=0.2, seed=args.seed)
+
+    torch.manual_seed(args.seed)
+    if device.type == "cuda":
+        torch.cuda.manual_seed_all(args.seed)
+    end, edge = build_split_pair(
+        normalize_model_name(args.model),
+        device,
+        input_channels=input_shape[0],
+        image_size=input_shape[1],
+        num_classes=num_classes,
+    )
+    end_state = {k: v.detach().clone() for k, v in end.state_dict().items()}
+    edge_state = {k: v.detach().clone() for k, v in edge.state_dict().items()}
+    with torch.no_grad():
+        feature_probe = end(torch.zeros((1, *input_shape), dtype=torch.float32, device=device))
+    feature_dim = int(feature_probe[0].numel())
+
+    if args.feature_noise_multiplier is None:
+        privacy_cfg = SelectionConfig(
+            rounds=args.rounds,
+            num_clients=args.clients,
+            num_edges=args.edges,
+            seed=args.seed,
+            initial_epsilon=args.initial_epsilon,
+            dp_feature_epsilon_budget=args.feature_epsilon_budget,
+            dp_delta=args.dp_delta,
+            privacy_local_epochs=args.local_epochs,
+            omega_learning_rate=args.lr,
+        )
+        privacy = resolved_privacy_parameters(privacy_cfg)
+        sigma_f = float(privacy["feature_noise_multiplier"])
+        horizon_events = int(privacy["feature_horizon_events"])
+    else:
+        sigma_f = float(args.feature_noise_multiplier)
+        horizon_events = -1
+
+    delta_z = 2.0 * float(args.feature_clip_norm)
+    k_update = float(args.lr) * float(args.feature_jacobian_norm) * float(args.feature_lipschitz)
+    # For I-split modes, one embedding release is counted per private local epoch
+    # in the formal event ledger.
+    m_events = int(args.local_epochs)
+    predicted_noise_only_local = (
+        k_update * k_update * m_events * feature_dim * (sigma_f * delta_z) ** 2
+    )
+
+    rows: list[dict[str, float | int | str]] = []
+    for client_id in args.client_ids:
+        if client_id < 0 or client_id >= len(client_train_indices):
+            raise ValueError(f"client id {client_id} is outside [0, {len(client_train_indices) - 1}]")
+        idx = client_train_indices[client_id]
+        x = x_train[idx]
+        y = y_train[idx]
+        training_seed = args.seed * 1_000_003 + client_id * 97 + 17
+
+        clean, clean_diag = _train_once(
+            mode=args.mode,
+            end_state=end_state,
+            edge_state=edge_state,
+            x=x,
+            y=y,
+            epochs=args.local_epochs,
+            lr=args.lr,
+            device=device,
+            model_name=args.model,
+            input_shape=input_shape,
+            num_classes=num_classes,
+            clip_norm=args.feature_clip_norm,
+            noise_multiplier=0.0,
+            use_feature_dp=False,
+            seed=training_seed,
+        )
+        clip, clip_diag = _train_once(
+            mode=args.mode,
+            end_state=end_state,
+            edge_state=edge_state,
+            x=x,
+            y=y,
+            epochs=args.local_epochs,
+            lr=args.lr,
+            device=device,
+            model_name=args.model,
+            input_shape=input_shape,
+            num_classes=num_classes,
+            clip_norm=args.feature_clip_norm,
+            noise_multiplier=0.0,
+            use_feature_dp=True,
+            seed=training_seed,
+        )
+        noisy, noisy_diag = _train_once(
+            mode=args.mode,
+            end_state=end_state,
+            edge_state=edge_state,
+            x=x,
+            y=y,
+            epochs=args.local_epochs,
+            lr=args.lr,
+            device=device,
+            model_name=args.model,
+            input_shape=input_shape,
+            num_classes=num_classes,
+            clip_norm=args.feature_clip_norm,
+            noise_multiplier=sigma_f,
+            use_feature_dp=True,
+            seed=training_seed,
+        )
+
+        clean_norm = _norm(clean)
+        row = {
+            "client_id": client_id,
+            "samples": len(idx),
+            "mode": args.mode,
+            "feature_dimension": feature_dim,
+            "feature_noise_multiplier": sigma_f,
+            "feature_clip_norm": args.feature_clip_norm,
+            "clean_update_norm": clean_norm,
+            "clip_update_norm": _norm(clip),
+            "dp_update_norm": _norm(noisy),
+            "empirical_clip_update_l2_sq": _sq_distance(clip, clean),
+            "empirical_noise_update_l2_sq": _sq_distance(noisy, clip),
+            "empirical_total_update_l2_sq": _sq_distance(noisy, clean),
+            "empirical_total_to_clean_norm_sq_ratio": _sq_distance(noisy, clean) / max(clean_norm * clean_norm, 1e-12),
+            "clean_vs_dp_cosine": _cosine(clean, noisy),
+            "predicted_noise_only_local_l2_sq": predicted_noise_only_local,
+            "empirical_to_predicted_noise_ratio": _sq_distance(noisy, clip) / max(predicted_noise_only_local, 1e-12),
+            "feature_raw_norm_mean": float(noisy_diag.get("feature_raw_norm_sum", 0.0)) / max(float(noisy_diag.get("feature_dp_sample_count", 0.0)), 1.0),
+            "feature_clipped_norm_mean": float(noisy_diag.get("feature_clipped_norm_sum", 0.0)) / max(float(noisy_diag.get("feature_dp_sample_count", 0.0)), 1.0),
+            "feature_noise_norm_mean": float(noisy_diag.get("feature_noise_norm_sum", 0.0)) / max(float(noisy_diag.get("feature_dp_sample_count", 0.0)), 1.0),
+            "feature_clipping_fraction": float(noisy_diag.get("feature_clipped_sample_count", 0.0)) / max(float(noisy_diag.get("feature_dp_sample_count", 0.0)), 1.0),
+        }
+        rows.append(row)
+        print(
+            f"client={client_id:3d} clean_norm={clean_norm:.6g} "
+            f"D_clip={row['empirical_clip_update_l2_sq']:.6g} "
+            f"D_noise={row['empirical_noise_update_l2_sq']:.6g} "
+            f"D_total={row['empirical_total_update_l2_sq']:.6g} "
+            f"pred_noise={predicted_noise_only_local:.6g} "
+            f"emp/pred={row['empirical_to_predicted_noise_ratio']:.3g}",
+            flush=True,
+        )
+
+    out = Path(args.output)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    with out.open("w", newline="", encoding="utf-8") as f:
+        writer = csv.DictWriter(f, fieldnames=list(rows[0].keys()))
+        writer.writeheader()
+        writer.writerows(rows)
+
+    numeric_keys = [
+        "clean_update_norm",
+        "empirical_clip_update_l2_sq",
+        "empirical_noise_update_l2_sq",
+        "empirical_total_update_l2_sq",
+        "empirical_total_to_clean_norm_sq_ratio",
+        "clean_vs_dp_cosine",
+        "predicted_noise_only_local_l2_sq",
+        "empirical_to_predicted_noise_ratio",
+        "feature_raw_norm_mean",
+        "feature_clipped_norm_mean",
+        "feature_noise_norm_mean",
+        "feature_clipping_fraction",
+    ]
+    summary = {
+        "clients": len(rows),
+        "mode": args.mode,
+        "feature_dimension": feature_dim,
+        "feature_noise_multiplier": sigma_f,
+        "feature_horizon_events": horizon_events,
+        **{
+            f"{key}_mean": float(np.mean([float(row[key]) for row in rows]))
+            for key in numeric_keys
+        },
+    }
+    summary_path = out.with_suffix(".summary.json")
+    summary_path.write_text(json.dumps(summary, indent=2), encoding="utf-8")
+    print(f"wrote {out}")
+    print(f"wrote {summary_path}")
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+    main()
