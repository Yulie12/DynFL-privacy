-"""Audit whether update-DP noise tiers remain distinguishable to the selector.
-
-This is a diagnostic only.  It does not change candidate generation, privacy
-accounting, Pareto objectives, or selection behavior.
-"""
-
-from __future__ import annotations
-
-import random
-from collections import defaultdict
-
-from dynfed.selection import (
-    ExposurePrivacyRequirement,
-    SelectionConfig,
-    _dedupe_candidates,
-    _local_omega_proxy,
-    build_client_privacy_ledger,
-    enumerate_candidates,
-)
-
-
-def _mechanism_key(candidate) -> tuple[tuple[str, str], ...]:
-    return tuple(sorted((candidate.link_mechanisms or candidate.mechanisms).items()))
-
-
-def main() -> None:
-    config = SelectionConfig(rounds=20, dp_tier_gamma=1.5, dp_tier_count=3)
-    ledger = build_client_privacy_ledger(config)
-    requirement = ExposurePrivacyRequirement(dp_required_links=frozenset({"L_C_upd"}))
-    candidates = enumerate_candidates(
-        config=config,
-        client_id=0,
-        edge_factor=1.0,
-        compute_factor=1.0,
-        samples=100,
-        remaining_epsilon=ledger.remaining_budget,
-        round_idx=0,
-        rng=random.Random(4101),
-        policy="ours",
-        privacy_ledger=ledger,
-        privacy_requirement=requirement,
-    )
-
-    liic_dp = [
-        candidate
-        for candidate in candidates
-        if candidate.mode == "LIIC" and candidate.update_dp_events > 0
-    ]
-    groups = defaultdict(list)
-    for candidate in liic_dp:
-        groups[_mechanism_key(candidate)].append(candidate)
-
-    if not groups:
-        raise SystemExit("FAIL: no LIIC update-DP candidates were enumerated")
-
-    print("Step41 privacy-tier distinguishability audit")
-    print(f"raw LIIC update-DP candidates: {len(liic_dp)}")
-    print(f"after selector-style dedupe: {len(_dedupe_candidates(liic_dp))}")
-
-    saw_three_tiers = False
-    saw_collapse = False
-    saw_strict_omega_increase = False
-    for mechanisms, group in sorted(groups.items()):
-        ordered = sorted(group, key=lambda item: float(item.update_noise_multiplier))
-        sigmas = [float(item.update_noise_multiplier) for item in ordered]
-        omegas = [_local_omega_proxy(item, config=config) for item in ordered]
-        times = [float(item.time) for item in ordered]
-        deduped = _dedupe_candidates(ordered)
-        print(f"mechanisms={dict(mechanisms)}")
-        print(f"  sigmas={sigmas}")
-        print(f"  local_omega={omegas}")
-        print(f"  latency={times}")
-        print(f"  raw={len(ordered)} deduped={len(deduped)}")
-
-        if len(ordered) == config.dp_tier_count:
-            saw_three_tiers = True
-        if len(ordered) > 1 and len(deduped) == 1:
-            saw_collapse = True
-        if len(omegas) > 1 and all(
-            right > left for left, right in zip(omegas, omegas[1:])
-        ):
-            saw_strict_omega_increase = True
-
-    if not saw_three_tiers:
-        raise SystemExit("FAIL: expected a three-tier LIIC update-DP family")
-    if not saw_collapse:
-        raise SystemExit("FAIL: selector-style dedupe did not collapse a tier family")
-    if not saw_strict_omega_increase:
-        raise SystemExit("FAIL: larger sigma did not strictly increase local Omega")
-
-    print("PASS: enumeration creates distinct sigma tiers")
-    print("PASS: current selector-style dedupe collapses tiers with identical mode/mechanisms")
-    print("PASS: larger sigma strictly increases current local Omega within the audited family")
-    print("CONCLUSION: current objectives provide no observed latency/Omega advantage for larger tiers")
-
-
-if __name__ == "__main__":
-    main()
