+def test_history_ema_j_mode_observation_is_mean_not_global_mass_scaled():
+    # Candidate-profile J applies sample mass once, after retrieving each Mode mean.
+    history = HistoryEMAJ(decay=0.5)
+    history.observe(
+        round_index=0, global_update=[1.0, 1.0],
+        mode_updates={"LIIC": [2.0, 0.0], "LIIEIIIC": [0.0, 4.0]},
+        global_history_eligible=True,
+    )
+    score, source = history.predict_profile_j(
+        {0: "LIIC", 1: "LIIEIIIC"}, {0: 3.0, 1: 1.0}
+    )
+    expected = normalized_squared_deviation([1.5, 1.0], history.global_ema)
+    assert source == "history_ema_j"
+    assert score == pytest.approx(expected)
