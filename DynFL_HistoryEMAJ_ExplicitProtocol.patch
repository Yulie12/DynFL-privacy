+def test_history_ema_j_config_does_not_require_environment_switch(monkeypatch):
+    import random
+    from dynfed.selection import SelectionConfig, enumerate_candidates, paper_client_privacy_requirement
+
+    monkeypatch.delenv("DYNFL_HISTORY_EMA_J_ENABLED", raising=False)
+    cfg = SelectionConfig(
+        num_clients=10, num_edges=2, privacy_unit="sample", allow_he=False,
+        update_mechanism_options=("dp",), learning_objective="history_ema_j",
+    )
+    candidates = enumerate_candidates(
+        config=cfg, client_id=0, edge_factor=1.0, compute_factor=1.0, samples=500,
+        remaining_epsilon=8.0, round_idx=0, rng=random.Random(2),
+        policy="full_dynfl", connected_edge_id=0,
+        privacy_requirement=paper_client_privacy_requirement(),
+    )
+    assert candidates
+    assert all(candidate.history_ema_j for candidate in candidates)
+    assert {candidate.mode for candidate in candidates} == {"LIIE", "LIIEIIIC", "LIIC"}
+    liiie = next((c for c in candidates if c.mode == "LIIEIIIC"), None)
+    assert liiie is not None, "History-EMA J must retain LIIEIIIC in the Sample-DP configuration"
+    assert liiie.link_mechanisms.get("L_E_upd") == "dp"
+    assert liiie.link_mechanisms.get("E_C_upd") is None
+
