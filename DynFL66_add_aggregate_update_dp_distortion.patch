+def distortion_metrics(reference: torch.Tensor, clipped_signal: torch.Tensor, noise: torch.Tensor) -> dict[str, float]:
+    """Decompose protected-vs-clean aggregate distortion in update space."""
+    if reference.shape != clipped_signal.shape or reference.shape != noise.shape:
+        raise ValueError("Reference, clipped signal, and noise must have matching shapes")
+    denom = max(float(reference.double().pow(2).sum()), 1e-24)
+    clip_error = clipped_signal - reference
+    protected = clipped_signal + noise
+    total_error = protected - reference
+    ref_norm = float(reference.norm())
+    protected_norm = float(protected.norm())
+    if ref_norm > 0.0 and protected_norm > 0.0:
+        cosine = float(torch.nn.functional.cosine_similarity(
+            reference.reshape(1, -1), protected.reshape(1, -1), dim=1
+        ).item())
+    else:
+        cosine = 0.0
+    d_clip = float(clip_error.double().pow(2).sum()) / denom
+    d_noise = float(noise.double().pow(2).sum()) / denom
+    d_total = float(total_error.double().pow(2).sum()) / denom
+    return {
+        "clean_aggregate_norm": ref_norm,
+        "protected_aggregate_norm": protected_norm,
+        "clip_error_norm": float(clip_error.norm()),
+        "total_error_norm": float(total_error.norm()),
+        "D_clip": d_clip,
+        "D_noise": d_noise,
+        "D_total": d_total,
+        "relative_error_norm": math.sqrt(max(d_total, 0.0)),
+        "clean_protected_cosine": cosine,
+    }
+
