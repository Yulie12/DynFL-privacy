diff --git a/experiments/diagnose_hierarchical_state_fidelity.py b/experiments/diagnose_hierarchical_state_fidelity.py
new file mode 100644
index 0000000..8bf616d
--- /dev/null
+++ b/experiments/diagnose_hierarchical_state_fidelity.py
@@ -0,0 +1,352 @@
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import math
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+import torch
+
+ROOT = Path(__file__).resolve().parents[1]
+RUNNER = ROOT / "experiments" / "run_fmnist_lenet5.py"
+
+MODES = ("LIE", "LIC", "LIIE", "LIIC", "LIEIIC", "LIEIIIC", "LIIEIIIC")
+RHO_VALUES = (0.25, 0.50, 0.75, 1.00)
+
+
+def parse_args() -> argparse.Namespace:
+    p = argparse.ArgumentParser(
+        description=(
+            "Stage-0 calibration of hierarchical learning-state fidelity. "
+            "Each collaboration mode is run alone for one clean/no-protection round, "
+            "then its Cloud and persistent Edge states are compared with full-model references."
+        )
+    )
+    p.add_argument("--output-root", default="out/hierarchical_state_fidelity")
+    p.add_argument(
+        "--reuse-existing",
+        action="store_true",
+        help="Reuse the newest checkpoint already present under each per-mode output directory.",
+    )
+    p.add_argument(
+        "runner_args",
+        nargs=argparse.REMAINDER,
+        help=(
+            "Arguments forwarded to experiments/run_fmnist_lenet5.py. "
+            "Place them after '--', e.g. -- --dataset cifar10 --model resnet18_pretrained_head."
+        ),
+    )
+    return p.parse_args()
+
+
+def _strip_separator(values: list[str]) -> list[str]:
+    return values[1:] if values and values[0] == "--" else values
+
+
+def _latest_checkpoint(root: Path) -> Path | None:
+    paths = list(root.rglob("checkpoint.pt")) if root.exists() else []
+    if not paths:
+        return None
+    return max(paths, key=lambda p: p.stat().st_mtime)
+
+
+def _run_one_mode(mode: str, output_root: Path, forwarded: list[str], reuse: bool) -> Path:
+    mode_root = output_root / mode
+    if reuse:
+        existing = _latest_checkpoint(mode_root)
+        if existing is not None:
+            print(f"[{mode}] reuse {existing}")
+            return existing
+
+    excluded = [item for item in MODES if item != mode]
+    cmd = [
+        sys.executable,
+        str(RUNNER),
+        *forwarded,
+        "--rounds", "1",
+        "--policies", "no_protection",
+        "--exclude-modes", *excluded,
+        "--resource-limit", "100",
+        "--memory-limit", "100",
+        "--risk-limit", "1.0",
+        "--aggregation-fraction", "1.0",
+        "--min-edge-cloud-fusion-ratio", "0.0",
+        "--he-backend", "none",
+        "--output-root", str(mode_root),
+    ]
+    print(f"[{mode}] running clean homogeneous profile")
+    subprocess.run(cmd, cwd=ROOT, check=True)
+    checkpoint = _latest_checkpoint(mode_root)
+    if checkpoint is None:
+        raise FileNotFoundError(f"[{mode}] no checkpoint.pt produced under {mode_root}")
+    return checkpoint
+
+
+def _load_checkpoint(path: Path) -> dict[str, Any]:
+    try:
+        return torch.load(path, map_location="cpu", weights_only=False)
+    except TypeError:
+        return torch.load(path, map_location="cpu")
+
+
+def _tensor_vector(state: dict[str, torch.Tensor]) -> torch.Tensor:
+    parts: list[torch.Tensor] = []
+    for key in sorted(state):
+        value = state[key]
+        if torch.is_tensor(value):
+            parts.append(value.detach().cpu().to(torch.float64).reshape(-1))
+    return torch.cat(parts) if parts else torch.zeros(0, dtype=torch.float64)
+
+
+def _nested_vector(state: dict[str, dict[str, torch.Tensor]]) -> torch.Tensor:
+    parts: list[torch.Tensor] = []
+    for group in ("end", "edge"):
+        group_state = state.get(group, {})
+        vec = _tensor_vector(group_state)
+        if vec.numel():
+            parts.append(vec)
+    return torch.cat(parts) if parts else torch.zeros(0, dtype=torch.float64)
+
+
+def _global_nested(checkpoint: dict[str, Any]) -> dict[str, dict[str, torch.Tensor]]:
+    return {
+        "end": checkpoint.get("global_end_state", {}),
+        "edge": checkpoint.get("global_edge_state", {}),
+    }
+
+
+def _last_round_rows(checkpoint: dict[str, Any]) -> list[dict[str, Any]]:
+    rows = list(checkpoint.get("decision_rows", []) or [])
+    if not rows:
+        return []
+    last_round = max(int(row.get("round", 0)) for row in rows)
+    return [row for row in rows if int(row.get("round", 0)) == last_round]
+
+
+def _client_edge_map(checkpoint: dict[str, Any]) -> dict[int, int]:
+    mapping: dict[int, int] = {}
+    for row in _last_round_rows(checkpoint):
+        try:
+            mapping[int(row["client_id"])] = int(row["edge_id"])
+        except (KeyError, TypeError, ValueError):
+            continue
+    return mapping
+
+
+def _normalized_client_states(checkpoint: dict[str, Any]) -> dict[int, dict[str, dict[str, torch.Tensor]]]:
+    raw = checkpoint.get("client_model_states", {}) or {}
+    out: dict[int, dict[str, dict[str, torch.Tensor]]] = {}
+    for key, value in raw.items():
+        try:
+            client_id = int(key)
+        except (TypeError, ValueError):
+            continue
+        if isinstance(value, dict):
+            out[client_id] = value
+    return out
+
+
+def _edge_states(
+    checkpoint: dict[str, Any],
+    initial_state: dict[str, dict[str, torch.Tensor]],
+    canonical_edges: set[int],
+) -> dict[int, dict[str, dict[str, torch.Tensor]]]:
+    mapping = _client_edge_map(checkpoint)
+    states = _normalized_client_states(checkpoint)
+    result: dict[int, dict[str, dict[str, torch.Tensor]]] = {}
+    for client_id in sorted(states):
+        edge_id = mapping.get(client_id)
+        if edge_id is not None and edge_id not in result:
+            result[edge_id] = states[client_id]
+    for edge_id in canonical_edges:
+        result.setdefault(edge_id, initial_state)
+    return result
+
+
+def _sq_norm(vec: torch.Tensor) -> float:
+    return float(torch.dot(vec, vec)) if vec.numel() else 0.0
+
+
+def _cosine(a: torch.Tensor, b: torch.Tensor) -> float:
+    if a.numel() == 0 or b.numel() == 0 or a.shape != b.shape:
+        return 0.0
+    na = float(torch.linalg.vector_norm(a))
+    nb = float(torch.linalg.vector_norm(b))
+    if na <= 1e-15 or nb <= 1e-15:
+        return 1.0 if na <= 1e-15 and nb <= 1e-15 else 0.0
+    value = float(torch.dot(a, b) / (na * nb))
+    return max(-1.0, min(1.0, value))
+
+
+def _distortion(current: torch.Tensor, reference: torch.Tensor, initial: torch.Tensor) -> dict[str, float]:
+    if current.shape != reference.shape or current.shape != initial.shape:
+        raise ValueError(
+            f"state-vector shape mismatch: current={tuple(current.shape)}, "
+            f"reference={tuple(reference.shape)}, initial={tuple(initial.shape)}"
+        )
+    update = current - initial
+    ref_update = reference - initial
+    diff = update - ref_update
+    ref_energy = _sq_norm(ref_update)
+    diff_energy = _sq_norm(diff)
+    return {
+        "update_norm": math.sqrt(max(_sq_norm(update), 0.0)),
+        "reference_update_norm": math.sqrt(max(ref_energy, 0.0)),
+        "distortion_sq": diff_energy,
+        "normalized_distortion": diff_energy / max(ref_energy, 1e-24),
+        "cosine": _cosine(update, ref_update),
+    }
+
+
+def _verify_clean_mode(mode: str, checkpoint: dict[str, Any]) -> tuple[int, int]:
+    rows = _last_round_rows(checkpoint)
+    executed = 0
+    skipped = 0
+    bad_modes: set[str] = set()
+    bad_mechanisms: set[str] = set()
+    for row in rows:
+        selected_mode = str(row.get("mode", ""))
+        if selected_mode == "SKIP":
+            skipped += 1
+            continue
+        executed += 1
+        if selected_mode != mode:
+            bad_modes.add(selected_mode)
+        mechanisms = str(row.get("mechanisms", ""))
+        if mechanisms and any(token in mechanisms for token in ("dp", "he", "trusted")):
+            bad_mechanisms.add(mechanisms)
+    if bad_modes:
+        raise RuntimeError(f"[{mode}] unexpected executed modes: {sorted(bad_modes)}")
+    if bad_mechanisms:
+        raise RuntimeError(f"[{mode}] no_protection run still used protection: {sorted(bad_mechanisms)}")
+    return executed, skipped
+
+
+def main() -> None:
+    args = parse_args()
+    forwarded = _strip_separator(list(args.runner_args))
+    output_root = Path(args.output_root).resolve()
+    output_root.mkdir(parents=True, exist_ok=True)
+
+    checkpoint_paths: dict[str, Path] = {}
+    checkpoints: dict[str, dict[str, Any]] = {}
+    execution_counts: dict[str, tuple[int, int]] = {}
+
+    for mode in MODES:
+        path = _run_one_mode(mode, output_root, forwarded, args.reuse_existing)
+        checkpoint_paths[mode] = path
+        checkpoint = _load_checkpoint(path)
+        checkpoints[mode] = checkpoint
+        execution_counts[mode] = _verify_clean_mode(mode, checkpoint)
+
+    # LIIE is Edge-only full-model training, so its Cloud state stays at the
+    # common initialization while its persistent Edge states provide a clean
+    # full-model Edge reference. LIIC provides the clean direct-Cloud reference.
+    initial_state = _global_nested(checkpoints["LIIE"])
+    initial_vec = _nested_vector(initial_state)
+    cloud_reference_vec = _nested_vector(_global_nested(checkpoints["LIIC"]))
+
+    canonical_mapping = _client_edge_map(checkpoints["LIIE"])
+    canonical_edges = set(canonical_mapping.values())
+    if not canonical_edges:
+        raise RuntimeError("LIIE calibration run did not expose any client->edge assignments")
+
+    edge_reference_states = _edge_states(
+        checkpoints["LIIE"], initial_state, canonical_edges
+    )
+    edge_client_counts = {
+        edge_id: sum(1 for value in canonical_mapping.values() if value == edge_id)
+        for edge_id in canonical_edges
+    }
+    total_edge_clients = max(sum(edge_client_counts.values()), 1)
+
+    rows: list[dict[str, Any]] = []
+    for mode in MODES:
+        checkpoint = checkpoints[mode]
+        current_cloud_vec = _nested_vector(_global_nested(checkpoint))
+        cloud = _distortion(current_cloud_vec, cloud_reference_vec, initial_vec)
+
+        current_edge_states = _edge_states(checkpoint, initial_state, canonical_edges)
+        edge_norm_distortion = 0.0
+        edge_distortion_sq = 0.0
+        edge_cosine = 0.0
+        edge_update_norm = 0.0
+        edge_reference_update_norm = 0.0
+
+        for edge_id in sorted(canonical_edges):
+            weight = edge_client_counts.get(edge_id, 0) / total_edge_clients
+            current_vec = _nested_vector(current_edge_states[edge_id])
+            reference_vec = _nested_vector(edge_reference_states[edge_id])
+            metric = _distortion(current_vec, reference_vec, initial_vec)
+            edge_norm_distortion += weight * metric["normalized_distortion"]
+            edge_distortion_sq += weight * metric["distortion_sq"]
+            edge_cosine += weight * metric["cosine"]
+            edge_update_norm += weight * metric["update_norm"]
+            edge_reference_update_norm += weight * metric["reference_update_norm"]
+
+        executed, skipped = execution_counts[mode]
+        row: dict[str, Any] = {
+            "mode": mode,
+            "executed_clients": executed,
+            "skipped_clients": skipped,
+            "checkpoint": str(checkpoint_paths[mode]),
+            "cloud_update_norm": cloud["update_norm"],
+            "cloud_reference_update_norm": cloud["reference_update_norm"],
+            "cloud_distortion_sq": cloud["distortion_sq"],
+            "normalized_cloud_distortion": cloud["normalized_distortion"],
+            "cloud_cosine": cloud["cosine"],
+            "edge_update_norm_weighted": edge_update_norm,
+            "edge_reference_update_norm_weighted": edge_reference_update_norm,
+            "edge_distortion_sq_weighted": edge_distortion_sq,
+            "normalized_edge_distortion": edge_norm_distortion,
+            "edge_cosine_weighted": edge_cosine,
+        }
+        for rho in RHO_VALUES:
+            row[f"effective_system_distortion_rho_{rho:.2f}"] = (
+                rho * cloud["normalized_distortion"]
+                + (1.0 - rho) * edge_norm_distortion
+            )
+        rows.append(row)
+
+    csv_path = output_root / "hierarchical_state_fidelity.csv"
+    json_path = output_root / "hierarchical_state_fidelity.json"
+    with csv_path.open("w", newline="", encoding="utf-8-sig") as handle:
+        writer = csv.DictWriter(handle, fieldnames=list(rows[0].keys()))
+        writer.writeheader()
+        writer.writerows(rows)
+
+    payload = {
+        "definition": {
+            "cloud_reference_mode": "LIIC",
+            "edge_reference_mode": "LIIE",
+            "initial_state_source": "LIIE Cloud state after one Edge-only clean round",
+            "privacy_policy": "no_protection",
+            "edge_weighting": "client-count weighting by Edge",
+            "normalized_distortion": "||Delta_mode-Delta_ref||_2^2 / max(||Delta_ref||_2^2, 1e-24)",
+            "rho_values": list(RHO_VALUES),
+        },
+        "rows": rows,
+    }
+    json_path.write_text(json.dumps(payload, indent=2), encoding="utf-8")
+
+    print("\nStage-0 hierarchical state fidelity")
+    for row in rows:
+        print(
+            f"{row['mode']:<10} "
+            f"n={row['executed_clients']:>3} "
+            f"Dc={row['normalized_cloud_distortion']:.6g} "
+            f"De={row['normalized_edge_distortion']:.6g} "
+            f"cosC={row['cloud_cosine']:.4f} "
+            f"cosE={row['edge_cosine_weighted']:.4f} "
+            f"J0.5={row['effective_system_distortion_rho_0.50']:.6g}"
+        )
+    print(f"CSV:  {csv_path}")
+    print(f"JSON: {json_path}")
+
+
+if __name__ == "__main__":
+    main()
