+#!/usr/bin/env python3
+"""Audit split-learning interaction counts against the selector latency model.
+
+This diagnostic does not change the selector. It compares the configured logical
+L_block_cycles with a workload-derived number of minibatch interactions and
+reports how link-event counts / communication latency change. It also flags the
+LIC direct-to-cloud split-compute multiplicity mismatch: link events repeat L
+steps while selector cloud_work is currently charged once.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import math
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from dynfed.selection import (  # noqa: E402
+    PRIVACY_ALPHA,
+    PRIVACY_BASE_TIME,
+    OBJECT_SIZES,
+    SelectionConfig,
+    _link_bandwidth,
+    _link_base_latency,
+    _mode_link_transmissions,
+    _profile_object_size,
+)
+from dynfed.training import MODE_SPECS  # noqa: E402
+
+MODES = ("LIE", "LIIE", "LIC", "LIIC", "LIEIIC", "LIEIIIC", "LIIEIIIC")
+SPLIT_MODES = {"LIE", "LIC", "LIEIIC", "LIEIIIC"}
+
+
+def _batch_size(model: str, device: str) -> int:
+    key = "".join(ch for ch in model.lower() if ch.isalnum())
+    gpu_large = {
+        "resnet18pretrainedadapter",
+        "resnet18pretrainedhead",
+        "resnet18pretrainedlayer4head",
+        "resnet18",
+        "resnet50",
+        "resnet18pretrained",
+        "resnet50pretrained",
+    }
+    return 128 if device.lower().startswith("cuda") and key in gpu_large else 64
+
+
+def _event_metrics(cfg: SelectionConfig, mode: str, L: int) -> tuple[float, float, dict[str, int]]:
+    spec = MODE_SPECS[mode]
+    total_time = 0.0
+    total_volume = 0.0
+    counts: dict[str, int] = {}
+    for link_id, obj, count, _privacy_eligible in _mode_link_transmissions(mode, L, spec.E_edge_loops):
+        # Use mechanism='none' deliberately: this diagnostic isolates topology/workload latency.
+        raw_size = _profile_object_size(cfg, obj)
+        mechanism = "none"
+        effective_size = raw_size * float(PRIVACY_ALPHA[mechanism])
+        rate = _link_bandwidth(cfg, 0, 1, link_id)
+        base_delay = _link_base_latency(cfg, link_id)
+        reference_size = max(float(OBJECT_SIZES[obj]), 1e-12)
+        privacy_processing = float(PRIVACY_BASE_TIME[mechanism]) * raw_size / reference_size
+        per_execution = effective_size / rate + base_delay + privacy_processing
+        total_time += count * per_execution
+        total_volume += count * effective_size
+        counts[obj] = counts.get(obj, 0) + int(count)
+    return total_time, total_volume, counts
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--train-limit", type=int, default=12000)
+    ap.add_argument("--clients", type=int, default=100)
+    ap.add_argument("--samples-per-client", type=int, default=None)
+    ap.add_argument("--local-epochs", type=int, default=3)
+    ap.add_argument("--model", default="resnet18_pretrained_head")
+    ap.add_argument("--device", default="cuda")
+    ap.add_argument("--fixed-L", type=int, default=5)
+    ap.add_argument("--output", type=Path, default=Path("out/split_interaction_latency_audit.csv"))
+    args = ap.parse_args()
+
+    samples = args.samples_per_client
+    if samples is None:
+        samples = int(math.ceil(args.train_limit / max(args.clients, 1)))
+    batch = _batch_size(args.model, args.device)
+    batches_per_epoch = max(1, int(math.ceil(samples / batch)))
+    workload_L = max(1, int(args.local_epochs) * batches_per_epoch)
+    fixed_L = max(1, int(args.fixed_L))
+
+    cfg = SelectionConfig(L_block_cycles=fixed_L)
+    rows = []
+
+    print(
+        f"samples/client={samples} batch={batch} epochs={args.local_epochs} "
+        f"fixed_L={fixed_L} workload_L={workload_L}"
+    )
+    print("mode       fixedComm  workComm  ratio    fixedMB  workMB  emb fixed->work  cloudSplitCompute")
+
+    for mode in MODES:
+        fixed_time, fixed_vol, fixed_counts = _event_metrics(cfg, mode, fixed_L)
+        work_time, work_vol, work_counts = _event_metrics(cfg, mode, workload_L)
+        ratio = work_time / fixed_time if fixed_time > 0 else 1.0
+        emb_fixed = fixed_counts.get("emb", 0)
+        emb_work = work_counts.get("emb", 0)
+
+        # In selector.py cloud_time = spec.cloud_work * 0.55 is charged once.
+        # For LIC, remote cloud compute is part of every split step, so this
+        # diagnostic reports the serial multiplicity gap explicitly.
+        spec = MODE_SPECS[mode]
+        cloud_once = float(spec.cloud_work) * 0.55
+        cloud_serial = cloud_once * workload_L if mode == "LIC" else cloud_once
+        cloud_gap = cloud_serial - cloud_once
+
+        row = {
+            "mode": mode,
+            "samples_per_client": samples,
+            "batch_size": batch,
+            "local_epochs": args.local_epochs,
+            "fixed_L": fixed_L,
+            "workload_L": workload_L,
+            "fixed_communication_time": fixed_time,
+            "workload_communication_time": work_time,
+            "workload_to_fixed_comm_ratio": ratio,
+            "fixed_communication_mb": fixed_vol,
+            "workload_communication_mb": work_vol,
+            "fixed_emb_events": emb_fixed,
+            "workload_emb_events": emb_work,
+            "fixed_grad_events": fixed_counts.get("grad", 0),
+            "workload_grad_events": work_counts.get("grad", 0),
+            "fixed_emb_grad_events": fixed_counts.get("emb_grad", 0),
+            "workload_emb_grad_events": work_counts.get("emb_grad", 0),
+            "selector_cloud_compute_once": cloud_once,
+            "serial_cloud_split_compute_workload": cloud_serial,
+            "cloud_split_compute_gap": cloud_gap,
+            "is_split_mode": int(mode in SPLIT_MODES),
+        }
+        rows.append(row)
+        print(
+            f"{mode:<10} {fixed_time:9.4f} {work_time:9.4f} {ratio:7.3f} "
+            f"{fixed_vol:8.3f} {work_vol:7.3f} {emb_fixed:4d} -> {emb_work:<4d} "
+            f"gap={cloud_gap:.4f}"
+        )
+
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open("w", newline="", encoding="utf-8") as f:
+        writer = csv.DictWriter(f, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+
+    print(f"wrote {args.output.resolve()}")
+    print(
+        "Interpretation: workload_L = local_epochs * ceil(samples_per_client / batch_size). "
+        "This file is diagnostic only; it does not alter selector behavior."
+    )
+
+
+if __name__ == "__main__":
+    main()
