+def _apply_aggregate_state_difference(
+    aggregate: dict[str, dict[str, torch.Tensor]],
+    global_end: torch.nn.Module,
+    global_edge: torch.nn.Module,
+    device: torch.device,
+) -> tuple[torch.nn.Module, torch.nn.Module]:
+    """Apply an already-weighted aggregate exactly once to the split model."""
+    for part_name, model in (("end", global_end), ("edge", global_edge)):
+        values = aggregate.get(part_name, {})
+        state = model.state_dict()
+        for name, param in model.named_parameters():
+            if not param.requires_grad or name not in values:
+                continue
+            state[name].data.add_(values[name].to(device=state[name].device, dtype=state[name].dtype))
+    return global_end, global_edge
+
+
+def _liic_streaming_secagg_eligible(
+    cloud_updates: list[tuple[Any, int, Candidate | None, list[int]]],
+    secure_fractions: list[float],
+    *,
+    execute_real_he: bool,
+    mainline_fusion: bool,
+) -> bool:
+    """Whether this cloud cohort can be released only as one LIIC SecAgg aggregate."""
+    if mainline_fusion or execute_real_he or len(cloud_updates) < 2:
+        return False
+    if len(cloud_updates) != len(secure_fractions):
+        return False
+    for (_state, _count, candidate, client_ids), fraction in zip(cloud_updates, secure_fractions):
+        if candidate is None or candidate.mode != "LIIC" or len(client_ids) != 1:
+            return False
+        if fraction <= 0.0:
+            return False
+    return True
+
