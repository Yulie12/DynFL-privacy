diff --git a/tests/test_diagnostic_partition_alignment.py b/tests/test_diagnostic_partition_alignment.py
new file mode 100644
index 0000000..443c928
--- /dev/null
+++ b/tests/test_diagnostic_partition_alignment.py
@@ -0,0 +1,69 @@
+import numpy as np
+
+import experiments.validate_edge_dp_trajectory as diagnostic
+from dynfed.fmnist_lenet5_dynamic import _partition_clients_lenet5, _split_client_indices
+
+
+def _labels(samples_per_class=120):
+    return np.repeat(np.arange(10, dtype=np.int64), samples_per_class)
+
+
+def test_diagnostic_exposes_formal_partition_builder():
+    assert hasattr(diagnostic, "build_diagnostic_client_splits")
+
+
+def test_iid_partition_and_holdout_match_formal_helpers():
+    builder = getattr(diagnostic, "build_diagnostic_client_splits")
+    y = _labels()
+    full, train, holdout = builder(
+        y,
+        num_clients=20,
+        num_edges=5,
+        partition_mode="iid",
+        holdout_ratio=0.2,
+        seed=42,
+    )
+    expected_full = _partition_clients_lenet5(y, 20, 5, True, "iid", 42)
+    expected_train, expected_holdout = _split_client_indices(expected_full, test_ratio=0.2, seed=42)
+    for actual, expected in zip(full, expected_full):
+        assert np.array_equal(actual, expected)
+    for actual, expected in zip(train, expected_train):
+        assert np.array_equal(actual, expected)
+    for actual, expected in zip(holdout, expected_holdout):
+        assert np.array_equal(actual, expected)
+
+
+def test_extreme_partition_holdout_is_disjoint_complete_and_reproducible():
+    builder = getattr(diagnostic, "build_diagnostic_client_splits")
+    y = _labels()
+    args = dict(
+        num_clients=20,
+        num_edges=5,
+        partition_mode="extreme_edge_label_skew",
+        holdout_ratio=0.2,
+        seed=42,
+    )
+    full_a, train_a, holdout_a = builder(y, **args)
+    full_b, train_b, holdout_b = builder(y, **args)
+    assert len(full_a) == len(train_a) == len(holdout_a) == 20
+    for full, train, holdout, full_again, train_again, holdout_again in zip(
+        full_a, train_a, holdout_a, full_b, train_b, holdout_b
+    ):
+        assert np.array_equal(full, full_again)
+        assert np.array_equal(train, train_again)
+        assert np.array_equal(holdout, holdout_again)
+        assert len(np.intersect1d(train, holdout)) == 0
+        assert np.array_equal(np.sort(np.concatenate([train, holdout])), np.sort(full))
+        assert len(train) > 0
+
+
+def test_partition_builder_rejects_invalid_holdout_ratio():
+    builder = getattr(diagnostic, "build_diagnostic_client_splits")
+    y = _labels()
+    for ratio in (-0.01, 1.0, float("nan")):
+        try:
+            builder(y, 20, 5, "iid", ratio, 42)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError(f"Expected ValueError for holdout ratio {ratio}")
