+def _pareto_profile_audit_rows(
+    *,
+    round_idx: int,
+    stage: str,
+    evaluations: list[ProfileEvaluation],
+    chosen: ProfileEvaluation | None,
+    norm_eps: float,
+) -> list[dict[str, Any]]:
+    if not evaluations:
+        return []
+
+    latency_values = [item.system_latency for item in evaluations]
+    learning_values = [item.system_learning_error for item in evaluations]
+    latency_min, latency_max = min(latency_values), max(latency_values)
+    learning_min, learning_max = min(learning_values), max(learning_values)
+    use_fusion = any(item.fusion_objective_enabled for item in evaluations)
+    fusion_values = [item.fusion_distortion for item in evaluations]
+    fusion_min = min(fusion_values) if use_fusion else 0.0
+    fusion_max = max(fusion_values) if use_fusion else 0.0
+    chosen_signature = chosen.profile_signature if chosen is not None else ()
+
+    rows: list[dict[str, Any]] = []
+    for profile_index, evaluation in enumerate(evaluations):
+        mode_counts = {mode: 0 for mode in MODE_SPECS}
+        for candidate in evaluation.profile.values():
+            if candidate.mode in mode_counts:
+                mode_counts[candidate.mode] += 1
+        normalized_latency = (
+            evaluation.system_latency - latency_min
+        ) / (latency_max - latency_min + norm_eps)
+        normalized_learning = (
+            evaluation.system_learning_error - learning_min
+        ) / (learning_max - learning_min + norm_eps)
+        normalized_fusion = (
+            (evaluation.fusion_distortion - fusion_min)
+            / (fusion_max - fusion_min + norm_eps)
+            if use_fusion
+            else 0.0
+        )
+        tchebycheff_score = max(
+            abs(normalized_latency),
+            abs(normalized_learning),
+            abs(normalized_fusion) if use_fusion else 0.0,
+        )
+        rows.append(
+            {
+                "round": round_idx,
+                "stage": stage,
+                "profile_index": profile_index,
+                "selected": int(
+                    chosen is evaluation
+                    or (
+                        bool(chosen_signature)
+                        and evaluation.profile_signature == chosen_signature
+                    )
+                ),
+                "LIE_count": mode_counts.get("LIE", 0),
+                "LIC_count": mode_counts.get("LIC", 0),
+                "LIIE_count": mode_counts.get("LIIE", 0),
+                "LIIC_count": mode_counts.get("LIIC", 0),
+                "LIEIIC_count": mode_counts.get("LIEIIC", 0),
+                "LIEIIIC_count": mode_counts.get("LIEIIIC", 0),
+                "LIIEIIIC_count": mode_counts.get("LIIEIIIC", 0),
+                "system_latency_objective": evaluation.system_latency,
+                "dp_perturbation_objective": evaluation.system_dp,
+                "feature_perturbation_objective": evaluation.feature_perturbation,
+                "fusion_bound_objective": evaluation.fusion_bound,
+                "learning_error_objective": evaluation.system_learning_error,
+                "cloud_fusion_ratio": evaluation.cloud_fusion_ratio,
+                "fusion_distortion_objective": evaluation.fusion_distortion,
+                "normalized_latency_within_stage": normalized_latency,
+                "normalized_learning_within_stage": normalized_learning,
+                "tchebycheff_score_within_stage": tchebycheff_score,
+                "admitted_client_count": len(evaluation.admitted_client_ids),
+            }
+        )
+    return rows
+
